# Copy to .env. Passwords go inside URLs: use hex, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too

# Where the browser reaches the app. Dev: the Vite server. Prod: https://your.domain
PUBLIC_URL=http://localhost:5173
# Prod only: the domain Caddy gets a certificate for
DOMAIN=localhost

# Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: <PUBLIC_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local dev/test only (docker-compose.yml sets its own for the containers)
DATABASE_URL=postgres://app:change-me-too@localhost:5433/zettlevault
MIGRATE_DATABASE_URL=postgres://postgres:change-me@localhost:5433/zettlevault

# Prod backups (scripts/backup.sh)
RCLONE_REMOTE=
HEALTHCHECK_URL=
